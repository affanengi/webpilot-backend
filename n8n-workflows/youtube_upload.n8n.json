    {
      "parameters": {
        "jsCode": "// DATA ONLY — no HTTP requests\nconst body = $('Webhook Initiate').first().json.body;\nconst sheetsRow = $('4A. Fetch Metadata from Sheets').first().json;\nconst values = sheetsRow.values?.[0] || [];\n\nconst driveFileId = values[4] || body.video_source || '';\nif (!driveFileId) throw new Error('No Drive File ID in Sheet column E.');\nif (!body.tokens?.youtube) throw new Error('Missing YouTube token.');\nif (!body.tokens?.google_drive) throw new Error('Missing Google Drive token.');\n\nreturn [{\n  json: {\n    snippet: {\n      title: values[0] || 'Untitled Video',\n      description: values[1] || '',\n      tags: values[2] ? values[2].split(',').map(t => t.trim()) : [],\n      categoryId: '22'\n    },\n    status: {\n      privacyStatus: (values[3] || 'private').toLowerCase()\n    },\n    _youtubeToken: body.tokens.youtube,\n    _driveToken: body.tokens.google_drive,\n    _driveFileId: driveFileId\n  }\n}];\n"
      },
