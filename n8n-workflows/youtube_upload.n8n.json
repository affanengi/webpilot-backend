      "id": "aa44080f-e0a5-4e4e-87e7-96abe998850b",
      "name": "3. Check Metadata Source (IF Node)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        2272,
        2768
      ]
    },
    {
      "parameters": {
        "jsCode": "// DATA ONLY — no HTTP requests\nconst body = $('Webhook Initiate').first().json.body;\n\nif (!body.video_source) throw new Error('Missing video_source (Google Drive File ID).');\nif (!body.tokens?.youtube) throw new Error('Missing YouTube token.');\nif (!body.tokens?.google_drive) throw new Error('Missing Google Drive token.');\n\nreturn [{\n  json: {\n    snippet: {\n      title: body.video_title || 'Untitled Video',\n      description: body.video_description || '',\n      tags: body.video_tags ? body.video_tags.split(',').map(t => t.trim()) : [],\n      categoryId: '22'\n    },\n    status: {\n      privacyStatus: (body.privacy_status || 'Private').toLowerCase()\n    },\n    _youtubeToken: body.tokens.youtube,\n    _driveToken: body.tokens.google_drive,\n    _driveFileId: body.video_source\n  }\n}];\n"
      },
      "id": "5364b645-79bf-453b-8f40-a591aec38834",
      "name": "4B. Prepare Metadata (Manual)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2528,
        2960
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/upload/youtube/v3/videos?uploadType=resumable&part=snippet,status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json._youtubeToken }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Upload-Content-Type",
              "value": "video/mp4"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { snippet: $json.snippet, status: $json.status } }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "text"
            }
          }
        }
      },
